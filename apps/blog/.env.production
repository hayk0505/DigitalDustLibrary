# Real value — digitaldustlibrary.com and its API subdomain are live as of
# 2026-08-10. Needed at build time (not just runtime) because PUBLIC_API_URL
# is inlined via $env/static/public. Committed on purpose, not a secret — see
# the !.env.production exception in this app's .gitignore for why.
PUBLIC_API_URL=https://api.digitaldustlibrary.com/api/public
